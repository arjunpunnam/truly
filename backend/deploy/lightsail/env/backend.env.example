# Spring profiles: choose one of sqlite, mysql, postgresql, turso
SPRING_PROFILES_ACTIVE=production,postgresql

# HTTP server settings
SERVER_PORT=8092
LOG_FILE=/var/log/truly/backend.log

# CORS allowlist used by WebConfig (comma-separated)
APP_CORS_ALLOWED_ORIGINS=https://truelyhq.com,https://www.truelyhq.com,https://your-vercel-domain.vercel.app

# JVM tuning
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseG1GC

# PostgreSQL profile
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ruleengine
POSTGRES_USER=ruleengine
POSTGRES_PASSWORD=change-me

# MySQL profile (only needed when using mysql profile)
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=ruleengine
# MYSQL_USER=ruleengine
# MYSQL_PASSWORD=change-me

# SQLite profile (only needed when using sqlite profile)
# SQLITE_PATH=/opt/truly/data/ruleengine.db
